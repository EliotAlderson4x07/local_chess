rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Clasificación oficial: lectura pública, escritura sólo para usuarios registrados y propietarios de su cuenta
    match /jugadores/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    // Salas de ajedrez multijugador en tiempo real
    match /salas/{roomId} {
      allow read, write: if true;
    }
  }
}
